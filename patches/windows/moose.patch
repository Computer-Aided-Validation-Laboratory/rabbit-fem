+void
+Exodus::meshChanged()
+{
+  // Maintain Sampled::meshChanged() functionality
+  SampledOutput::meshChanged();
+
+  // Indicate to the Exodus object that the mesh has changed
+  _exodus_mesh_changed = true;
+}
