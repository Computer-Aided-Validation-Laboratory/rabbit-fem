+    const auto op = vs.token();
+    if (op == "&")
+      return OP_AND;
+    if (op == "|")
+      return OP_OR;
+    checkException(vs, "unknown logic operator.");
+  };
+
+  enum Operator
+  {
+    OP_LESS_EQ,
+    OP_GREATER_EQ,
+    OP_LESS,
+    OP_GREATER,
+    OP_NOT_EQ,
+    OP_EQ
+  };
+
+  parser["Operator"] = [](const SemanticValues & vs)
+  {
+    const auto op = vs.token();
+    if (op == "<=")
+      return OP_LESS_EQ;
+    if (op == ">=")
+      return OP_GREATER_EQ;
+    if (op == "<")
+      return OP_LESS;
+    if (op == ">")
+      return OP_GREATER;
+    if (op == "!=")
+      return OP_NOT_EQ;
+    if (op == "=" || op == "==")
+      return OP_EQ;
+    checkException(vs, "unknown operator.");
+  };
